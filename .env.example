# Copy this file to .env.local for the Windows launcher, or to .env for Docker Compose.
# In production mode, the key is required and uploaded-data Runs do not silently fall back.
GT_APP_MODE=production
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# GT_DATABASE_URL is optional: local launcher uses ./data; Compose supplies /app/data.
GT_COOKIE_SECURE=false
GT_GUEST_TTL_SECONDS=7200
GT_HARD_GRACE_SECONDS=120
GT_LIVE_DAILY_LIMIT=30
GT_LLM_REQUEST_TIMEOUT_SECONDS=60
# Optional admin console. Generate the PBKDF2 hash with:
#   cd backend && python -m app.services.admin_auth
# Paste the generated hash inside single quotes; never put a plain password here.
GT_ADMIN_PASSWORD_HASH=
